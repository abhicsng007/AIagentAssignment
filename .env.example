OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Rate-limit handling (429 Too Many Requests)
LLM_MAX_RETRIES=6
LLM_RETRY_BASE_DELAY=4
LLM_RETRY_MAX_DELAY=60
LLM_CALL_GAP=1.5

# Validation
ENABLE_VALIDATION=true
# Live server/HTTP checks. Soft-pass if MongoDB is down or node_modules is broken.
# Set false for syntax-only validation (recommended if MongoDB is not installed).
ENABLE_SERVER_VALIDATION=true

ENABLE_GIT=true
MAX_RETRIES=2
